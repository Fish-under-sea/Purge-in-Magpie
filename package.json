{
  "name": "@fish-under-sea/magpie-purge",
  "version": "0.3.2",
  "description": "magpie-purge: a magpie page plugin that treats a local purge folder as a free plugin/skill source, inspects and validates what is in it, and rewrites the gateway's system prompt by mode (off / strict / replace / append).",
  "type": "module",
  "license": "MIT",
  "files": [
    "hooks.js",
    "lib",
    "page",
    "skills",
    "personas",
    "tools",
    "preview",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "purge",
    "agent-purge",
    "system-prompt",
    "gateway-hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/magpie-purge.git"
  },
  "homepage": "https://github.com/Fish-under-sea/magpie-purge#readme",
  "bugs": {
    "url": "https://github.com/Fish-under-sea/magpie-purge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "scan": "node tools/scan.mjs",
    "test": "node --test --test-isolation=none \"tests/*.test.mjs\"",
    "preview": "node tools/build-preview.mjs",
    "preview:serve": "node preview/serve.mjs --demo",
    "prepack": "node tools/prepack.mjs && node tools/build-preview.mjs && node tools/card-icon.mjs"
  },
  "magpie": {
    "hooks": "./hooks.js",
    "icon": "data:image/png;base64,",
    "page": {
      "title": "Purge in Magpie",
      "titles": {
        "zh": "破甲 · Purge",
        "zh-TW": "破甲 · Purge",
        "ja": "Purge",
        "de": "Purge"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "options": {
      "sources": [],
      "mode": "",
      "persona": "",
      "agents": [],
      "enabled": {},
      "pinned": {},
      "imports": [],
      "refreshAt": 0,
      "gatewayTimeoutMs": 1500
    }
  }
}
